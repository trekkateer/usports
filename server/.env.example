SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: how many minutes before start to warn players of an under-filled game (default 60)
AT_RISK_WARNING_MINUTES=60
# Optional: how often to check for under-filled games, in milliseconds (default 60000)
AT_RISK_CHECK_INTERVAL_MS=60000
